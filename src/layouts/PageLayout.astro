---
import BaseLayout from './BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';

interface Props {
  title: string;
  eyebrow: string;
  lede?: string;
  description?: string;
}

const { title, eyebrow, lede, description } = Astro.props;
---

<BaseLayout title={title} description={description ?? lede}>
  <div class="shell page-head">
    <SectionHeader as="h1" eyebrow={eyebrow} title={title} lede={lede} class="enter" />
  </div>
  <slot />
</BaseLayout>

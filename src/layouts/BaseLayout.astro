---
import { site } from '../data/site';
import { link } from '../lib/link';
import Aurora from '../components/Aurora.astro';
import GrainOverlay from '../components/GrainOverlay.astro';
import NavBar from '../components/nav/NavBar.astro';
import MobileMenu from '../components/nav/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  aurora?: 'hero' | 'page';
}

const { title, description = site.description, aurora = 'page' } = Astro.props;
const fullTitle = title === site.name ? `${site.name} — ${site.experiment}` : `${title} · ${site.name}`;

/* Absolute URLs, required by Open Graph — relative paths are ignored by most
   unfurlers. Both resolve against `site` in astro.config.mjs, so pointing the
   project at a different domain updates every page at once. */
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-card.png', Astro.site);
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A143C" />
    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    {site.googleSiteVerification && (
      <meta name="google-site-verification" content={site.googleSiteVerification} />
    )}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.team} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Team CLOT-LESS mission patch beside the experiment title: A Quantitative Analysis of Thrombolysis Kinetics in Microgravity." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* en-CA rather than plain en: this is a Canadian Space Agency campaign and
        the audience, funders and search intent are Canadian. */}
    <meta property="og:locale" content="en_CA" />
    <StructuredData />

    {/*
      Runs before first paint. Adds .js-reveal, which gates the reveal
      animation's hidden state, AND arms a failsafe that strips it again if the
      reveal module never runs.

      The failsafe is the important part. "JS disabled" is the easy case — this
      script never runs, the class never lands, everything is visible. The
      dangerous case is this inline script succeeding while the module bundle
      does not: a partial deploy, a blocked request, or a throw in any earlier
      init. Without the timeout, .js-reveal would survive with nothing left to
      clear it and every page would sit at opacity 0 forever. reveal.ts cancels
      the timer as soon as it takes over.
    */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js-reveal');
        window.__revealFailsafe = setTimeout(() => {
          root.classList.remove('js-reveal');
        }, 2000);
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Aurora intensity={aurora} />
    <GrainOverlay />

    {/*
      Deliberately NOT transition:persist. The nav's active state is per-page —
      persisting the old element across a swap would freeze `is-current` and
      `aria-current="page"` on whichever page you first landed on, telling
      screen readers the wrong thing. It is cheap to re-render.
    */}
    <NavBar />
    <MobileMenu />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <script>
      import { initNav } from '../scripts/nav';
      import { initReveal } from '../scripts/reveal';

      // Plain multi-page navigation: each page is a fresh document load, so
      // this module runs once per page and boots directly. No view-transition
      // re-binding — that machinery was adding 2–3s to every page change, and
      // static navigation to these pre-rendered pages paints in ~150ms instead.
      // Prefetch keeps each page's HTML warm in cache, so the browser's own
      // navigation is effectively instant.
      initNav();
      initReveal();
    </script>
  </body>
</html>

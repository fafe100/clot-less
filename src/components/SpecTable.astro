---
interface Props {
  rows: { label: string; value: string; note?: string }[];
  caption?: string;
}

const { rows, caption } = Astro.props;
---

<div class="spec">
  {caption && <p class="t-eyebrow spec__caption">{caption}</p>}
  <dl class="spec__list">
    {rows.map((row) => (
      <div class="spec__row">
        <dt class="spec__label">{row.label}</dt>
        <dd class="spec__value">
          <span class="t-num spec__figure">{row.value}</span>
          {row.note && <span class="spec__note">{row.note}</span>}
        </dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .spec__caption {
    margin-block-end: var(--space-4);
  }

  .spec__list {
    margin: 0;
    border-block-start: 1px solid var(--border-hairline);
  }

  .spec__row {
    display: grid;
    grid-template-columns: minmax(140px, 0.8fr) 1.2fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-block-end: 1px solid var(--border-hairline);
  }

  .spec__label {
    font-size: var(--t-caption);
    color: var(--text-tertiary);
  }

  .spec__value {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
  }

  .spec__figure {
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--text-primary);
  }

  .spec__note {
    font-size: var(--t-caption);
    color: var(--text-tertiary);
  }

  @media (width < 560px) {
    .spec__row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>

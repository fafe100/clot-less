---
/** A small static status label. Interactive pills are the gallery filter
 *  buttons, which are real <button>s styled in gallery.astro. */
interface Props {
  tone?: 'neutral' | 'accent' | 'muted';
  class?: string;
  [key: string]: unknown;
}

const { tone = 'neutral', class: className, ...rest } = Astro.props;
const classes = ['pill', `pill--${tone}`, className].filter(Boolean).join(' ');
---

<span class={classes} {...rest}>
  <slot />
</span>

<style>
  .pill {
    padding: 0.28rem 0.7rem;
    font-size: var(--t-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border-radius: var(--r-pill);
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
    text-decoration: none;
    background-color: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px var(--border-hairline);
    color: var(--text-tertiary);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  .pill--accent {
    color: var(--accent);
    background-color: var(--accent-muted);
    box-shadow: inset 0 0 0 1px var(--accent-ring);
  }

  .pill--muted {
    color: var(--text-tertiary);
    background-color: rgb(255 255 255 / 0.03);
  }

</style>

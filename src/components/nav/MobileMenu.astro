---
import { nav } from '../../data/site';
import { link, isCurrent } from '../../lib/link';

const pathname = Astro.url.pathname;
---

<div
  class="menu"
  id="mobile-menu"
  data-menu
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
>
  <div class="menu__sheet glass glass--blur">
    {/* The exit has to live INSIDE the dialog. aria-modal="true" hides
        everything outside this element from a screen reader, and the burger
        that opened the menu is in the nav — outside. Without this button the
        only remaining exits are a nav link or the Escape key, neither of which
        is reachable for someone confined to the modal on a touch device. */}
    <button class="menu__close" type="button" data-menu-close aria-label="Close menu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8"
              stroke-linecap="round"/>
      </svg>
    </button>

    <ul class="menu__list" role="list">
      {nav.map((item, i) => {
        const current = isCurrent(link(item.href), pathname);
        return (
          <li style={`--i:${i}`}>
            <a
              class:list={['menu__link', current && 'is-current']}
              href={link(item.href)}
              aria-current={current ? 'page' : undefined}
            >
              <span>{item.label}</span>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</div>

<style>
  /* Scrollable, because the sheet does not always fit. Six links plus the close
     control need ~509px; a phone in landscape has 360-393px of viewport. The
     page behind is locked (`html { overflow: hidden }`) while the menu is open,
     so without this the last two links were physically unreachable. */
  .menu {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-nav) - 1);
    display: none;
    padding: calc(var(--nav-h) + var(--space-5)) var(--gutter) var(--space-6);
    background-color: rgb(0 10 30 / 0.55);
    overflow-y: auto;
    /* Keeps a flick at either end of the sheet from chaining to the document. */
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .menu[data-open] {
    display: block;
    animation: fade-rise var(--dur-fast) var(--ease-out) both;
  }

  .menu__sheet {
    padding: var(--space-3);
    border-radius: var(--r-xl);
  }

  .menu__close {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    /* Pushed to the trailing edge; the list below it stays full width. */
    margin-inline-start: auto;
    margin-block-end: var(--space-2);
    border-radius: 50%;
    color: var(--text-secondary);
    background-color: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px var(--border-hairline);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .menu__close:active {
    background-color: rgb(255 255 255 / 0.11);
  }

  .menu__list {
    margin: 0;
    padding: 0;
  }

  .menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    /* Radius nesting law: sheet radius (32) − sheet padding (12) = 20 ≈ --r-md. */
    padding: var(--space-4) var(--space-4);
    border-radius: var(--r-md);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .menu__link.is-current {
    color: var(--accent);
    background-color: var(--accent-muted);
  }

  .menu__link:active {
    background-color: rgb(255 255 255 / 0.07);
  }

  .menu__list li + li {
    border-block-start: 1px solid var(--border-hairline);
  }

  @media (width >= 860px) {
    .menu { display: none !important; }
  }
</style>

---
import { nav } from '../../data/site';
import { link, isCurrent } from '../../lib/link';

const pathname = Astro.url.pathname;
---

<div
  class="menu"
  id="mobile-menu"
  data-menu
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
>
  <div class="menu__sheet glass glass--blur">
    <ul class="menu__list" role="list">
      {nav.map((item, i) => {
        const current = isCurrent(link(item.href), pathname);
        return (
          <li style={`--i:${i}`}>
            <a
              class:list={['menu__link', current && 'is-current']}
              href={link(item.href)}
              aria-current={current ? 'page' : undefined}
            >
              <span>{item.label}</span>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</div>

<style>
  .menu {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-nav) - 1);
    display: none;
    padding: calc(var(--nav-h) + var(--space-5)) var(--gutter) var(--space-6);
    background-color: rgb(0 10 30 / 0.55);
  }

  .menu[data-open] {
    display: block;
    animation: fade-rise var(--dur-fast) var(--ease-out) both;
  }

  .menu__sheet {
    padding: var(--space-3);
    border-radius: var(--r-xl);
  }

  .menu__list {
    margin: 0;
    padding: 0;
  }

  .menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    /* Radius nesting law: sheet radius (32) − sheet padding (12) = 20 ≈ --r-md. */
    padding: var(--space-4) var(--space-4);
    border-radius: var(--r-md);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .menu__link.is-current {
    color: var(--accent);
    background-color: var(--accent-muted);
  }

  .menu__link:active {
    background-color: rgb(255 255 255 / 0.07);
  }

  .menu__list li + li {
    border-block-start: 1px solid var(--border-hairline);
  }

  @media (width >= 860px) {
    .menu { display: none !important; }
  }
</style>

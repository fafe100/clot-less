---
import { initials, monogramGradient } from '../lib/monogram';

/**
 * Headshot fallback.
 *
 * Occupies the exact same box as a real photo so a grid mixing the two stays
 * even. Colours come from a curated navy-to-blush ramp keyed off the name, so a
 * full grid of monograms looks like a designed set rather than a broken one.
 *
 * Sized in container-query units against the card, so the initials stay
 * optically correct whether the card is 280px or 600px wide.
 */
interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
const { from, to } = monogramGradient(name);
---

<div
  class:list={['mono', className]}
  style={`--from:${from};--to:${to}`}
  aria-hidden="true"
>
  <span class="mono__sheen" aria-hidden="true"></span>
  <span class="mono__ring" aria-hidden="true"></span>
  <span class="mono__initials" aria-hidden="true">{initials(name)}</span>
</div>

<style>
  .mono {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
    background: var(--from);
  }

  /* A soft diagonal highlight so the tile reads as the same material as the
     glass around it, rather than a flat colour swatch. Sits below the initials
     in DOM order so it cannot wash them out. */
  .mono__sheen { display: none; }

  /* Echoes the emblem's roundel — makes the placeholder feel like part of the
     mission identity rather than a missing-image state. */
  .mono__ring {
    position: absolute;
    width: 62cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgb(250 250 250 / 0.1);
  }

  .mono__initials {
    position: relative;
    font-size: clamp(2.25rem, 26cqw, 7rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1;
    color: rgb(250 250 250 / 0.44);
    user-select: none;
  }
</style>

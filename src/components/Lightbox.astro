---
/**
 * Native <dialog>. Focus trapping, ESC-to-close, inert background and the
 * ::backdrop pseudo-element all come from the platform — no modal library.
 */
---

<dialog class="lb" data-lightbox aria-label="Photo viewer">
  <div class="lb__inner">
    <figure class="lb__figure">
      <img class="lb__img" data-lightbox-img src="" alt="" />
      <figcaption class="lb__meta glass glass--solid glass--r-md" data-lightbox-meta>
        <p class="lb__caption" data-lightbox-caption></p>
        <p class="t-caption" data-lightbox-phase></p>
      </figcaption>
    </figure>

    <button class="lb__ctl lb__ctl--prev" type="button" data-lightbox-prev>
      <span class="visually-hidden">Previous photo</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <button class="lb__ctl lb__ctl--next" type="button" data-lightbox-next>
      <span class="visually-hidden">Next photo</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.8"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <button class="lb__ctl lb__ctl--close" type="button" data-lightbox-close>
      <span class="visually-hidden">Close</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8"
              stroke-linecap="round"/>
      </svg>
    </button>

    <p class="lb__counter t-num" data-lightbox-counter aria-live="polite"></p>
  </div>
</dialog>

<style>
  /* Full-viewport dialog. The global reset (`* { margin: 0 }`) strips the
     browser's `margin: auto` centring from modal dialogs, which left the old
     fixed-width box pinned to the top-left with its controls hanging off it.
     Filling the viewport and centring with grid makes the layout independent of
     that default, and lets the controls sit at the screen edges where they
     never overlap or crop the photo. */
  .lb {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
    color: var(--text-secondary);
  }

  .lb::backdrop {
    background-color: rgb(0 10 30 / 0.86);
    -webkit-backdrop-filter: blur(var(--blur-xl)) saturate(140%);
    backdrop-filter: blur(var(--blur-xl)) saturate(140%);
  }

  .lb[open] .lb__figure {
    animation: scale-in var(--dur-base) var(--ease-spring) both;
  }

  .lb__inner {
    --ctl: 44px;
    --edge: clamp(12px, 2vw, 24px);
    /* Room the arrows need on each side, so the photo never runs under them. */
    --side: calc(var(--ctl) + var(--edge) * 2);
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: calc(var(--ctl) + var(--edge) * 2) var(--side) var(--edge);
  }

  .lb__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    width: 100%;
    height: 100%;
    min-height: 0;
    margin: 0;
  }

  /* As large as the screen allows, never upscaled past the file's own size,
     always whole: the image shrinks to fit the space left after the caption. */
  .lb__img {
    flex: 0 1 auto;
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--r-md);
    box-shadow: var(--shadow-3);
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  /* Set by the script between one photo and the next landing. */
  .lb__img.is-loading {
    opacity: 0.4;
  }

  /* The caption sits under the image, not over it. */
  .lb__meta {
    flex: 0 0 auto;
    max-width: min(100%, 68ch);
    padding: var(--space-3) var(--space-5);
    text-align: center;
  }

  .lb__meta:has(.lb__caption:empty) {
    display: none;
  }

  .lb__caption {
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--text-primary);
  }

  .lb__ctl {
    position: fixed;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--ctl);
    height: var(--ctl);
    border-radius: 50%;
    color: var(--text-primary);
    background-color: rgb(16 27 71 / 0.82);
    box-shadow: inset 0 0 0 1px var(--border-soft), var(--shadow-2);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-micro) var(--ease-spring);
  }

  .lb__ctl:hover {
    background-color: rgb(22 34 79 / 0.95);
  }

  .lb__ctl:active {
    transform: scale(0.94);
  }

  .lb__ctl--prev,
  .lb__ctl--next { inset-block-start: calc(50% - var(--ctl) / 2); }
  .lb__ctl--prev { inset-inline-start: var(--edge); }
  .lb__ctl--next { inset-inline-end: var(--edge); }
  .lb__ctl--close { inset-block-start: var(--edge); inset-inline-end: var(--edge); }

  .lb__counter {
    position: fixed;
    inset-block-start: calc(var(--edge) + 8px);
    inset-inline-start: var(--edge);
    padding: 0.3rem 0.7rem;
    font-size: var(--t-caption);
    font-weight: 600;
    border-radius: var(--r-pill);
    color: var(--text-tertiary);
    background-color: rgb(16 27 71 / 0.82);
  }

  /* Phones: the photo takes the full width; the arrows move down beside the
     caption instead of covering the picture. */
  @media (max-width: 699.98px) {
    .lb__inner {
      --side: var(--edge);
      padding-block-end: calc(var(--ctl) + var(--edge) * 2);
    }

    .lb__ctl--prev,
    .lb__ctl--next { inset-block-start: auto; inset-block-end: var(--edge); }
  }

  /* glass.css covers everything carrying a .glass class, but ::backdrop is a
     pseudo-element on the dialog itself and no class can reach it — so the one
     blurred surface on the page was the one surface still blurring for someone
     who asked the OS not to. An opaque wash instead. */
  @media (prefers-reduced-transparency: reduce) {
    .lb::backdrop {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background-color: rgb(0 10 30 / 0.95);
    }
  }

  @media (forced-colors: active) {
    .lb::backdrop {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: Canvas;
    }
  }
</style>

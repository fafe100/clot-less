---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import TeamCard from '../components/TeamCard.astro';
import GlassPanel from '../components/glass/GlassPanel.astro';
import Reveal from '../components/Reveal.astro';
import groupPhoto from '../assets/team/group-1.jpg';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  eyebrow="Crew"
  title="Meet our team"
  lede="Medicine, pharmacy and engineering on the same problem — a student-led team spanning two universities and three faculties."
>
  <section class="section section--tight">
    <div class="shell">
      <Reveal>
        <GlassPanel class="team__hero" radius="2xl" elevation={3}>
          <Image
            src={groupPhoto}
            alt="Four members of Team CLOT-LESS standing together outdoors at sunset, with the ocean and mountains behind them."
            widths={[720, 1200, 2000]}
            sizes="(max-width: 1179.98px) 92vw, 1100px"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="team__hero-img"
          />
        </GlassPanel>
      </Reveal>
    </div>
  </section>

  <section class="section section--tight">
    <div class="shell">
      {/* One ordered grid rather than a section per role. Role is still shown
          on every card as a pill, so the distinction survives without three
          separate headings putting visual distance between people who are all
          one team. Order is content-controlled via each member's `order:`. */}
      <ul class="team-grid" role="list">
        {team.map((entry, i) => (
          <Reveal as="li" index={i}>
            <TeamCard entry={entry} />
          </Reveal>
        ))}
      </ul>
    </div>
  </section>
</PageLayout>

<style>
  /* Fixed 3-up rather than auto-fit: the first row is meant to be three
     specific people, which an auto-fitting column count cannot guarantee. */
  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 620px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 940px) {
    .team-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .team__hero {
    overflow: hidden;
    padding: var(--space-2);
  }

  .team__hero-img {
    width: 100%;
    height: auto;
    max-height: 54svh;
    object-fit: cover;
    /* The photo is 4:3 and the frame is much wider, so `cover` discards about a
       third of the height. Centred, that crop starts around 17% down — right
       through everyone's heads, which sit between 5% and 25%. Biasing the crop
       to 10% keeps a sliver of sky above the tallest head and drops the excess
       off the bottom instead, where there is only foreground. */
    object-position: center 10%;
    /* Nesting law: --r-2xl (44) − 8px padding = 36 ≈ --r-xl. */
    border-radius: var(--r-xl);
  }
</style>

---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SponsorCard from '../components/SponsorCard.astro';
import GlassPanel from '../components/glass/GlassPanel.astro';
import Reveal from '../components/Reveal.astro';
import { sponsorTiers, site } from '../data/site';

const sponsors = (await getCollection('sponsors', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<PageLayout
  eyebrow="Support"
  title="Partners and sponsors"
  lede="CLOT-LESS runs on donated hardware, granted funding and flight infrastructure none of us could have built. Here is who provided what."
>
  {sponsorTiers.map((tier) => {
    const group = sponsors.filter((s) => s.data.tier === tier.id);
    if (group.length === 0) return null;
    return (
      <section class="section">
        <div class="shell">
          <SectionHeader
            eyebrow={`${group.length} ${group.length === 1 ? "partner" : "partners"}`}
            title={tier.label}
            lede={tier.blurb}
          />
          <ul class="grid-auto" role="list" style="--col-min:300px">
            {group.map((entry, i) => (
              <Reveal as="li" index={i}>
                <SponsorCard entry={entry} />
              </Reveal>
            ))}
          </ul>
        </div>
      </section>
    );
  })}

  <section class="section">
    <div class="shell">
      <Reveal>
        <GlassPanel class="partners__cta" radius="2xl">
          <p class="t-eyebrow">Get involved</p>
          <h2 class="t-h2 partners__cta-title">Support the campaign</h2>
          <p class="t-lede partners__cta-lede">
            The project is funded through a mix of student grants, in-kind
            hardware donations and the team's own contributions. If your
            organisation works in thrombosis, microfluidics, imaging or
            spaceflight medicine, we would like to hear from you.
          </p>
          <a class="btn btn--primary" href={`mailto:${site.contact}`}>Get in touch</a>
        </GlassPanel>
      </Reveal>
    </div>
  </section>
</PageLayout>

<style>
  .partners__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-7) var(--space-6) calc(var(--space-7) + 4px);
    text-align: center;
  }

  .partners__cta-title {
    max-width: 20ch;
  }

  .partners__cta-lede {
    max-width: 56ch;
  }

  .partners__cta .btn {
    margin-block-start: var(--space-2);
  }
</style>

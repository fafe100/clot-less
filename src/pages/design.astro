---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SubsystemSection from '../components/SubsystemSection.astro';
import StatTile from '../components/StatTile.astro';
import FlightProfile from '../components/FlightProfile.astro';
import FlowPath from '../components/FlowPath.astro';
import GlassPanel from '../components/glass/GlassPanel.astro';
import Reveal from '../components/Reveal.astro';

const design = (await getCollection('design')).sort((a, b) => a.data.order - b.data.order);
const overview = design.find((d) => d.data.order === 0)!;
const subsystems = design.filter((d) => d.data.order > 0);
const { Content: Overview } = await render(overview);
---

<PageLayout
  eyebrow="Payload"
  title="Project design"
  lede="A closed-loop microfluidic system that perfuses a thrombolytic drug through clot-laden microchannels and measures the pressure change in real time — packed into a single flight case."
>
  <section class="section section--tight">
    <div class="shell design__intro">
      <Reveal class="prose">
        <Overview />
      </Reveal>

      <Reveal class="design__hero-wrap" index={1}>
        {overview.data.hero && (
          <GlassPanel class="design__hero" radius="xl" elevation={3}>
            <Image
              src={overview.data.hero}
              alt={overview.data.heroAlt ?? 'CAD render of the CLOT-LESS payload'}
              widths={[520, 1000]}
              sizes="(width < 940px) 92vw, 540px"
              loading="eager"
              decoding="async"
              class="design__hero-img"
            />
          </GlassPanel>
        )}
      </Reveal>
    </div>
  </section>

  <section class="section section--tight">
    <div class="shell">
      <ul class="grid-auto" role="list" style="--col-min:200px">
        {overview.data.stats.map((stat, i) => (
          <Reveal as="li" index={i}>
            <StatTile value={stat.value} label={stat.label} detail={stat.detail} />
          </Reveal>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeader
        eyebrow="How it runs"
        title="Twenty seconds, two button presses"
        lede="The usable science window is about twenty seconds long and the operator is floating. Everything that can be automated, is."
      />
      <div class="design__ops">
        <Reveal><FlightProfile /></Reveal>
        <Reveal index={1}><FlowPath /></Reveal>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeader
        eyebrow="Architecture"
        title="Five subsystems"
        lede="Structure, fluidics, power, command and data handling, and imaging — each with the part numbers behind it."
      />
      {subsystems.map((entry, i) => (
        <SubsystemSection entry={entry} index={i} />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="shell design__pair">
      <Reveal>
        <GlassPanel class="design__panel" radius="xl">
          <p class="t-eyebrow">Samples</p>
          <h3 class="t-h3">Clots formed in place</h3>
          <p class="design__panel-body">
            In-vitro clots are made from porcine blood, recalcified with calcium
            chloride inside the collagen-coated microchannels so they form against
            the channel wall rather than being transferred in. Preparation happens
            the morning of each flight day: load the blood, add the calcium
            chloride, incubate, confirm the clot has formed.
          </p>
          <p class="design__panel-body">
            All samples are classified <strong>Biosafety Level 1 / Risk
            Group 1</strong>. Used slides go into a sharps container post-flight;
            absorbent pads inside the case act as secondary containment.
          </p>
        </GlassPanel>
      </Reveal>

      {/* Safety gets the deep maroon wash rather than the bright signal red.
          Saturated red on navy vibrates and reads as an error state — maroon
          carries the same vessel identity at a luminance that stays calm. */}
      <Reveal index={1}>
        <GlassPanel class="design__panel design__panel--safety" radius="xl">
          <p class="t-eyebrow design__safety-brow">Safety</p>
          <h3 class="t-h3">Failure means nothing happens</h3>
          <p class="design__panel-body">
            A normally-closed emergency stop is hardwired into the case. Cut power
            — deliberately or otherwise — and the pumps stop dead while all eight
            pinch valves de-energize.
          </p>
          <p class="design__panel-body">
            Because those valves are <strong>normally open</strong>, losing power
            opens the tubes rather than clamping them. With no pump running there
            is no driving pressure anywhere in the system, so the fluid simply goes
            still. On an aircraft, the safest failure mode is the boring one.
          </p>
          <ul class="design__levels" role="list">
            <li><span>Level 1</span> Software reset of the affected component</li>
            <li><span>Level 2</span> Skip the channel for the rest of the flight</li>
            <li><span>Level 3</span> Pause all triggering; diagnose at level flight</li>
          </ul>
        </GlassPanel>
      </Reveal>
    </div>
  </section>
</PageLayout>

<style>
  .design__intro {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }

  @media (width >= 940px) {
    .design__intro {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-10);
    }
  }

  .design__hero {
    overflow: hidden;
    padding: var(--space-2);
    background-color: rgb(250 250 248 / 0.94);
  }

  .design__hero-img {
    width: 100%;
    height: auto;
    border-radius: var(--r-lg);
  }

  .design__ops {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .design__pair {
    display: grid;
    gap: var(--space-5);
  }

  @media (width >= 880px) {
    .design__pair {
      grid-template-columns: 1fr 1fr;
    }
  }

  .design__panel {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-6) var(--space-6) calc(var(--space-6) + 4px);
  }

  .design__panel--safety {
    background-image:
      linear-gradient(180deg, rgb(255 255 255 / 0.045) 0%, rgb(255 255 255 / 0) 42%),
      radial-gradient(120% 90% at 10% 0%, rgb(110 20 20 / 0.4) 0%, transparent 62%);
  }

  .design__safety-brow {
    color: #ffb3ad;
  }

  .design__panel-body {
    font-size: var(--t-small);
    line-height: 1.65;
  }

  .design__panel-body strong {
    color: var(--text-primary);
  }

  .design__levels {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
    margin: auto 0 0;
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--border-hairline);
    list-style: none;
  }

  .design__levels li {
    display: flex;
    gap: var(--space-3);
    font-size: var(--t-caption);
    line-height: 1.5;
    color: var(--text-tertiary);
  }

  .design__levels span {
    flex: 0 0 52px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-primary);
  }
</style>

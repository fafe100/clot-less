---
import { getCollection } from 'astro:content';
import CabinPhoto from '../components/CabinPhoto.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageLayout from '../layouts/PageLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import type { GalleryItem } from '../components/GalleryGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import Reveal from '../components/Reveal.astro';
import { GALLERY_IMAGES, getGalleryThumb } from '../lib/images';

/**
 * Photos are discovered by globbing src/assets/gallery/, so dropping a new
 * image in makes it appear on the next build. The matching Markdown file is an
 * OPTIONAL sidecar that adds a caption, category and grid span — without it the
 * photo still shows, with a generic alt.
 */
const meta = new Map((await getCollection('gallery')).map((e) => [e.id, e.data]));

const items: GalleryItem[] = Object.entries(GALLERY_IMAGES)
  .map(([id, image]) => {
    const m = meta.get(id);
    return {
      id,
      image,
      thumb: getGalleryThumb(id) ?? image,
      alt: m?.alt ?? 'Team CLOT-LESS payload build progress photograph.',
      caption: m?.caption,
      category: m?.category ?? 'prototype',
      phase: m?.phase,
      date: m?.date,
      span: m?.span ?? '1x1',
      order: m?.order ?? 999,
    };
  })
  .sort((a, b) => a.order - b.order || a.id.localeCompare(b.id));

const CATEGORIES = [
  { id: 'all', label: 'All' },
  { id: 'prototype', label: 'Prototype' },
  { id: 'fluidics', label: 'Fluidics' },
  { id: 'electronics', label: 'Electronics' },
  { id: 'cad', label: 'CAD' },
  { id: 'team', label: 'Team' },
  { id: 'outreach', label: 'Outreach' },
];

// Only offer a filter for categories that actually have photos behind them.
const present = new Set(items.map((i) => i.category));
const categories = CATEGORIES.filter((c) => c.id === 'all' || present.has(c.id));

const videos = [
  { id: 'vtCYrKcYKMw', label: 'Flight campaign · clip 1', short: true },
  { id: 'rPgQQqF3R4Q', label: 'Flight campaign · clip 2', short: true },
  { id: '_uP86RT1KPQ', label: 'Flight campaign · clip 3', short: true },
  { id: 'X2ObDfVjtqk', label: 'Flight campaign · video', short: false },
];
---

<PageLayout
  eyebrow="In the lab and in flight"
  title="From the bench to the flight"
  lede="The experimental platform, the people behind it, and moments from the CAN-RGX flight campaign."
>
  <section class="section section--tight">
    <div class="shell">
      {/* Reveal the bar and the grid as blocks rather than per tile: a gallery
          cell can be `hidden` by the category filter, and a hidden element is
          never seen by the reveal observer, so it would stay at opacity 0 when
          filtered back in. Animating the container sidesteps that entirely. */}
      <Reveal>
        <div class="gallery__bar" data-gallery-filter role="group" aria-label="Filter photos by category">
          {categories.map((c) => (
            <button
              class:list={[c.id === 'all' && 'is-active']}
              type="button"
              data-category={c.id}
              aria-pressed={c.id === 'all' ? 'true' : 'false'}
            >
              {c.label}
            </button>
          ))}
        </div>

        {/* Live region so filtering isn't a silent change for screen readers —
            the count is updated by initGalleryFilter. */}
        <p
          class="t-caption gallery__count"
          data-gallery-count
          aria-live="polite"
        >
          {items.length} photograph{items.length === 1 ? '' : 's'}
        </p>
      </Reveal>

      <Reveal index={1}>
        <GalleryGrid items={items} />
      </Reveal>
    </div>
  </section>

  <section class="section">
    <div class="shell cabin">
      <div>
        <SectionHeader eyebrow="Flight campaign" title="Inside the aircraft" lede="The team and experiment together in the cabin during the CAN-RGX campaign." />
        <p><a href="#campaign-videos">Watch the campaign videos ↓</a></p>
      </div>
      <figure class="cabin__figure">
        <CabinPhoto />
        <figcaption class="t-caption">A view from inside the cabin.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="campaign-videos">
    <div class="shell">
      <SectionHeader eyebrow="Watch" title="Flight campaign videos" />
      <div class="videos">
        {videos.map((video) => (
          <article class:list={['video', !video.short && 'video--wide']}>
            <iframe src={`https://www.youtube-nocookie.com/embed/${video.id}`} title={video.label} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            <h3 class="t-small"><a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer">{video.label} · Watch on YouTube ↗</a></h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Lightbox />
</PageLayout>

<script>
  import { initLightbox, initGalleryFilter } from '../scripts/lightbox';

  // Runs once per page load — no view-transition re-binding.
  initLightbox();
  initGalleryFilter();
</script>

<style>
  .cabin { display: grid; gap: var(--space-8); align-items: center; }
  .cabin__figure { margin: 0; }
  .cabin__figure figcaption { margin-top: var(--space-3); }
  .videos { display: grid; gap: var(--space-6); }
  .video { min-width: 0; }
  .video iframe { display: block; width: 100%; aspect-ratio: 9 / 16; border: 0; border-radius: var(--r-md); background: var(--surface-inset); }
  .video--wide iframe { aspect-ratio: 16 / 9; }
  .video h3 { margin-top: var(--space-3); }
  @media (min-width: 760px) {
    .cabin { grid-template-columns: 1fr 1fr; }
    .videos { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .video--wide { grid-column: 1 / -1; max-width: 840px; width: 100%; justify-self: center; }
  }

  .gallery__bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-end: var(--space-4);
  }

  /* Filter buttons. Styled here rather than reusing GlassPill: these are real
     <button>s with pressed state, and GlassPill is a static label. */
  .gallery__bar button {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.95rem;
    font-size: var(--t-caption);
    font-weight: 600;
    border-radius: var(--r-pill);
    color: var(--text-tertiary);
    background-color: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px var(--border-hairline);
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .gallery__bar button.is-active {
    color: var(--text-on-accent);
    background-color: var(--accent);
    box-shadow: none;
  }

  @media (hover: hover) {
    .gallery__bar button:not(.is-active):hover {
      color: var(--text-primary);
      background-color: rgb(255 255 255 / 0.11);
    }
  }

  .gallery__count {
    margin-block-end: var(--space-6);
  }
</style>
